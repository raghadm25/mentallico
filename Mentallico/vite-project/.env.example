# Copy this file to .env and fill in the values. Never commit the real .env.

# Leave blank for local dev — API calls stay relative ("/api/v1") and ride
# Vite's dev-server proxy straight to Django. In production (no dev-server
# proxy exists), set this to the deployed backend's absolute origin, e.g.
# https://mentallico-api.onrender.com
VITE_API_BASE_URL=

# From Google Cloud Console -> APIs & Services -> Credentials ->
# Create Credentials -> OAuth client ID -> Web application.
# Add http://localhost:5173 as an Authorized JavaScript origin.
# Must match the backend's GOOGLE_OAUTH_CLIENT_ID (in the repo root .env) exactly —
# it's the same Client ID used on both sides.
VITE_GOOGLE_CLIENT_ID=

# From developers.facebook.com -> My Apps -> Create App -> Consumer ->
# Settings -> Basic. App IDs are public (safe in frontend code) — only the
# App Secret must stay server-side (in the repo root .env, never here).
# Must match the backend's FACEBOOK_APP_ID exactly.
VITE_FACEBOOK_APP_ID=
