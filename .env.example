# ============================================================
#  Environment configuration template
#  Copy this file to .env and fill in the values.
#  Never commit the real .env file to version control.
# ============================================================

# ---- Django core ------------------------------------------------
DEBUG=True
SECRET_KEY=change-me-to-a-50-char-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Database ---------------------------------------------------
# SQLite (development default — no extra setup required)
DATABASE_URL=sqlite:///db.sqlite3

# PostgreSQL (production example)
# DATABASE_URL=postgres://user:password@localhost:5432/mentallico_db

# ---- Celery / Redis broker -------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/0

# ---- JWT token lifetimes ---------------------------------------
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ---- CORS -------------------------------------------------------
# Add every frontend origin that needs API access (comma-separated, no trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# ---- Email (optional — console backend used in development) ----
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# ---- Hugging Face AI integration (Mentallico-API-v2 Space) -----
# Base URL of the Space's own web server (NOT the huggingface.co/spaces/... page).
HF_SPACE_BASE_URL=https://ziad9022-mentallico-api-v2.hf.space
# Only needed if the Space is private / rate-limited to token holders. Leave blank otherwise.
HF_API_TOKEN=
HF_API_TIMEOUT_SECONDS=30

# ---- Google Sign-In ----------------------------------------------
# From Google Cloud Console -> APIs & Services -> Credentials ->
# Create Credentials -> OAuth client ID -> Web application.
# Add http://localhost:5173 as an Authorized JavaScript origin.
# Must match Mentallico/vite-project/.env's VITE_GOOGLE_CLIENT_ID exactly.
# Leave blank to disable — the endpoint returns a clear 503 until it's set.
GOOGLE_OAUTH_CLIENT_ID=
